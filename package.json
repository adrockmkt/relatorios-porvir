{
  "name": "relatorios-porvir",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dev:api": "npm --prefix server run dev",
    "db:migrate": "npm --prefix server run migrate",
    "db:seed": "npm --prefix server run seed",
    "install:api": "npm --prefix server install",
    "install:all": "npm install && npm --prefix server install",
    "audit:dependencies": "npm audit && npm --prefix server audit",
    "check:api": "npm --prefix server run check",
    "check:public-security": "node scripts/check-public-security.mjs",
    "check:periods": "node scripts/check-report-periods.mjs",
    "check": "npm run check:periods && npm run check:public-security && npm run build && npm run check:api"
  },
  "dependencies": {
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "vite": "^8.3.8"
  }
}
