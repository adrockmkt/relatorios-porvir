[Unit]
Description=Porvir Reports Hub API
After=network.target postgresql.service

[Service]
Type=simple
WorkingDirectory=/var/www/relatorios_porvir/server
EnvironmentFile=/var/www/relatorios_porvir/server/.env
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=5
User=www-data
Group=www-data
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
